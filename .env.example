# AI provider selection
LLM_PROVIDER=mock

# Provider secrets - leave blank in source control
GEMINI_API_KEY=

# Model IDs remain configuration, never hardcoded in product logic
LLM_FAST_MODEL=gemini-3.6-flash
LLM_CAPABLE_MODEL=gemini-3.6-flash
EMBEDDING_MODEL=gemini-embedding-001

# Local infrastructure
MONGO_URL="mongodb://localhost:27017/voyage?replicaSet=rs0&directConnection=true"
REDIS_URL=redis://localhost:6379
VOYAGE_DATA_DIR=

# Session / hold behavior
SESSION_TTL_SECONDS=3600
HOLD_TTL_SECONDS=600

# Agent controls
LLM_TIMEOUT_MS=20000
MAX_TOOL_STEPS=4
RETRIEVAL_TOP_K=3

# Signed checkout handoff
BOOKING_CONTEXT_SECRET=replace-me

# Feature / telemetry
FEATURE_AI_ENABLED=true
OTEL_ENABLED=true
