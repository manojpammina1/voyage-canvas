# Copy to .env and fill in your read-only Azure Blob SAS URL.
# NEVER commit .env to git.
#
# Required permissions: Read + List on the claude-price-dashboard container.
# Issued by your DevOps org. Rotate quarterly.
#
VITE_TELEMETRY_READ_SAS=https://<account>.blob.core.windows.net/<container>?sv=...&sp=rl&sig=...
