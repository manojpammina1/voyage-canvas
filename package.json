{
  "name": "voyage-app",
  "version": "0.1.0",
  "private": true,
  "description": "Voyage Canvas — RCG Part 1 Agentic Cruise Planning Assistant POC",
  "packageManager": "pnpm@10.34.5",
  "scripts": {
    "dev": "pnpm --filter @voyage/web dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:int": "pnpm -r --filter @voyage/inventory --filter @voyage/commerce test",
    "seed": "tsx scripts/seed.ts",
    "demo:reset": "tsx scripts/demo-reset.ts",
    "eval": "tsx eval/runEval.ts",
    "eval:validate": "tsx eval/validateCases.ts",
    "eval:retrieval": "tsx eval/runRetrievalEval.ts",
    "redteam": "tsx eval/runRedteam.ts",
    "latest-trace": "tsx scripts/latest-trace.ts"
  },
  "dependencies": {
    "ioredis": "^5.4.2",
    "mongodb": "^6.12.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8",
    "zod": "^3.24.1"
  }
}
